# Copy to .env.local for development, or set on the host for production.

# Absolute path to SQLite when the working directory is ephemeral (Docker/volume).
# PLAYED_DB=/app/data/played.sqlite

# Required for real confirmation and password-reset email.
# Without both, the link is shown on the next screen instead.
RESEND_API_KEY=
RESEND_FROM=Played <onboarding@resend.dev>

# Show Book or Call on public courses that have a switch on in data/reach.json.
# Launch: set to 1. Unset or any other value keeps the feature off.
BOOKING_ENABLED=1

# Plausible site domain (create the site in Plausible first). Empty = no script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Golf Canada live score pull (optional). Both required; feed itself is not wired yet.
# GOLFCANADA_CLIENT_ID=
# GOLFCANADA_CLIENT_SECRET=
